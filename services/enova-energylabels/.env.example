# Enova public-data API (energimerkeordningen). Get a free subscription key at
# https://data.enova.no (sign up -> subscribe to the public energy-label product).
ENOVA_API_KEY=your-ocp-apim-subscription-key

# Comma-separated kommune numbers to pull. Default is Oslo (0301).
ENOVA_KOMMUNER=0301

# Where the ingest writes and the API reads.
ENOVA_DATABASE_URL=postgresql+psycopg://enova:enova@localhost:5432/enova

# --- Optional tuning ---------------------------------------------------------
# ENOVA_BASE_URL=https://api.data.enova.no/ems/offentlige-data/v1
# ENOVA_ENDPOINT=Energiattest
# ENOVA_PAGE_SIZE=1000
# ENOVA_MAX_PAGES_PER_KOMMUNE=50
# ENOVA_MAX_TOTAL=100000

# --- Request-schema overrides (set from the real docs once available) --------
# ENOVA_PARAM_KOMMUNE=Kommunenummer
# ENOVA_PARAM_PAGE=Side
# ENOVA_PARAM_PAGE_SIZE=AntallPerSide
# ENOVA_PAGE_START=1
# ENOVA_RESULTS_PATH=
