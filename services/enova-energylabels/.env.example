# Enova public-data API. Energy-label bulk files are fetched in two hops:
#   GET {base}/v{N}/Fil/{year}/{month}  (x-api-key)  -> a signed CSV URL
#   GET <that signed URL>                            -> the monthly CSV
# The client picks v1 (pre-2026) or v2 (2026+) automatically by year.
ENOVA_API_KEY=your-enova-api-key

# Where the ingest writes and the API reads.
ENOVA_DATABASE_URL=postgresql+psycopg://enova:enova@localhost:5432/enova

# Which months to pull ([start .. end] inclusive; end defaults to now).
# Default start (2009) covers the full published history across v1 + v2.
ENOVA_START_YEAR=2009
ENOVA_START_MONTH=1
# ENOVA_END_YEAR=2026
# ENOVA_END_MONTH=7

# --- Optional tuning / overrides --------------------------------------------
# ENOVA_BASE_URL=https://api.data.enova.no/ems/offentlige-data
# ENOVA_ENDPOINT=Fil
# ENOVA_API_KEY_HEADER=x-api-key
# ENOVA_V2_START_YEAR=2026
# ENOVA_REQUEST_TIMEOUT=120
# ENOVA_MAX_RECORDS=0            # 0 = unlimited
