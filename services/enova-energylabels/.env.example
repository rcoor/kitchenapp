# Enova public-data API (v2). The energy-label bulk files are served as
#   GET {base}/Fil/{year}/{month}   with an x-api-key header.
ENOVA_API_KEY=your-enova-api-key

# Where the ingest writes and the API reads.
ENOVA_DATABASE_URL=postgresql+psycopg://enova:enova@localhost:5432/enova

# Which months to pull ([start .. end] inclusive; end defaults to now).
ENOVA_START_YEAR=2010
ENOVA_START_MONTH=1
# ENOVA_END_YEAR=2026
# ENOVA_END_MONTH=7

# --- Optional tuning / overrides --------------------------------------------
# ENOVA_BASE_URL=https://api.data.enova.no/ems/offentlige-data/v2
# ENOVA_ENDPOINT=Fil
# ENOVA_API_KEY_HEADER=x-api-key
# ENOVA_REQUEST_TIMEOUT=120
# ENOVA_MAX_RECORDS=0            # 0 = unlimited
# ENOVA_RESULTS_PATH=           # dotted path to the array if a file wraps it
